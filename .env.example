DATABASE_URL="file:./data/bud.db"

# Optional HTTP Basic authentication for intentional remote deployment.
# Set both values together. Local Docker access remains bound to 127.0.0.1 by default.
BUD_BUD_USERNAME=""
BUD_BUD_PASSWORD=""

# Comma-separated additional origins allowed to make state-changing API requests.
BUD_BUD_ALLOWED_ORIGINS=""
